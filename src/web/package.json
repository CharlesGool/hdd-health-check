{
  "name": "hdd-health-web",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "build": "npm run typecheck && node node_modules/vite/bin/vite.js build",
    "check:design": "node scripts/check-design.mjs",
    "check": "npm run format:check && npm run check:design && npm run build",
    "test:ui": "node ../../tests/web-ui.mjs",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{vue,ts,css}\" \"*.json\" vite.config.ts ../../tests/web-ui.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{vue,ts,css}\" \"*.json\" vite.config.ts ../../tests/web-ui.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "markdown-it": "^15.0.2",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  }
}
