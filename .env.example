# Shell checker and Python Web service: optional absolute private-state path.
# Existing state is reused. Directory must be private and not a symbolic link.
# HDD_STATE_DIR=/absolute/path/to/private-state
# Shell checker and Python Web service: optional absolute log directory.
# HDD_LOG_DIR=/absolute/path/to/private-logs
# Shell checker: optional nonempty value disables terminal ANSI colors.
# NO_COLOR=1
# Shell checker: optional nonempty value disables interactive background handoff.
# HDD_NO_BG=1
